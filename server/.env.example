# ============================================
# 星云 SCRM 服务端环境变量示例
# ============================================
# 复制一份为 .env 并按需修改即可。
# dotenv/config 会自动加载，不需要手动 export。

# --- 运行环境 ---
NODE_ENV=dev            # dev | prod
PORT=3001               # Express 监听端口；IDE 预览容器需 5173

# --- JWT 鉴权 ---
JWT_SECRET=please-change-this-secret-to-a-random-string
JWT_EXPIRES_IN=7d       # 例如 1h / 7d / 30d / 1y

# --- CORS ---
# 开发默认 localhost:5173；生产必须显式列出你的前端域名（逗号分隔多个）
# 设为 false 或空字符串则完全禁止跨域（内网部署推荐）
# CORS_ORIGIN=https://scrm.yourcompany.com
CORS_ORIGIN=

# --- 企微 API（必填，未配置则以 simulated 模式运行）---
WECOM_CORP_ID=
WECOM_CORP_SECRET=
# 会话存档需要
WECOM_MSG_AUDIT_AGENT_ID=
WECOM_MSG_AUDIT_AGENT_SECRET=
# 视频号小店 Webhook 需要
CHANNELS_SHOP_AES_KEY=
CHANNELS_SHOP_TOKEN=

# --- MCP 只读模式（可选，设为 true 时关闭写接口）---
SCRM_MCP_READONLY=false
